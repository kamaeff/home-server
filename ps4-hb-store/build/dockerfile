FROM node:14 AS build

RUN npm install -g --no-cache pkg

RUN mkdir -p /build
WORKDIR /build

RUN git clone https://github.com/Gkiokan/hb-store-cdn-cli-server.git .
RUN npm ci

RUN npm run build:linux


FROM debian:stable-slim

RUN mkdir app
WORKDIR /app

COPY config.ini config.ini
COPY --from=build /build/release/hb-store-cdn-cli-server main
RUN ./main download-bin

EXPOSE 6449

RUN mkdir /pkg

CMD ["/app/main", "start"]
