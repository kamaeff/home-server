{
    order crowdsec first
    order appsec after crowdsec

    crowdsec {
        api_url http://crowdsec:8080
        api_key {env.CROWDSEC_API_KEY}
        ticker_interval 15s
        appsec_url http://crowdsec:7422
        # see also: https://github.com/crowdsecurity/crowdsec/issues/3837
        appsec_max_body_bytes 2097152
    }

    servers {
        strict_sni_host on
        trusted_proxies_strict
	    # cloudflared tunnels
        trusted_proxies static 192.168.0.0/24
        client_ip_headers CF-Connecting-IP
    }
}

(tls) {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }
}

(rproxy) {
    reverse_proxy {args[:]} {
        {block}
        header_up x-forwarded-for "{client_ip}"
        header_up x-real-ip "{client_ip}"
    }
}

(external) {
    import tls
    log
    crowdsec
    appsec
}

vw.{$SERVICE_DOMAIN},
vw-ext.{$SERVICE_DOMAIN} {
    import external
    import rproxy vw:80
}

# internal copyparty
https://drive.{$SERVICE_DOMAIN} {
    import tls
    import rproxy copyparty:3923
}

# faster cleartext http for PS4 FPKGi copyparty
http://drive.{$SERVICE_DOMAIN} {
    handle /fpkgi/* {
        import rproxy copyparty:3923
    }
    handle {
        redir https://drive.{$SERVICE_DOMAIN}{uri} permanent
    }
}

# public copyparty
files.{$PERSONAL_DOMAIN} {
    import external
    # disable public GET access to /fpkgi/ volume
    handle /fpkgi/* {
        redir https://youtu.be/dQw4w9WgXcQ permanent
    }
    handle {
        import rproxy copyparty:3923
    }
}

files.{$SERVICE_DOMAIN} {
    import external
    @allow path /shared-links/* /.cpr/*
    handle @allow {
        import rproxy copyparty:3923
    }
    handle {
        redir https://youtu.be/dQw4w9WgXcQ permanent
    }
}

(collabora) {
    @collabora path_regexp ^/(browser|cool|hosting/(discovery|capabilities))(/.*)?$
    handle @collabora {
        import rproxy http://collabora:9980
    }
    handle {
        redir https://youtu.be/dQw4w9WgXcQ permanent
    }
}

