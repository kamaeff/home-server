{
    servers {
        strict_sni_host on
        trusted_proxies_strict
	    # cloudflared tunnels
        trusted_proxies static 192.168.0.0/24
        client_ip_headers CF-Connecting-IP
    }
}

(tls) {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }
}

(rproxy) {
    reverse_proxy {args[0]} {
        {block}
        header_up -x-forwarded-for
        header_up x-real-ip "{client_ip}"
    }
}

vw.{$SERVICE_DOMAIN},
vw-ext.{$SERVICE_DOMAIN} {
    import tls
    import rproxy vw:80
}


(copyparty) {
    import rproxy http://copyparty:3923
}

drive.{$SERVICE_DOMAIN} {
    import tls
    import copyparty
}

drive-ext.{$SERVICE_DOMAIN} {
    import tls
    @public_paths {
	method GET HEAD OPTIONS TRACE
        path /shared-links/public*
        path /.cpr/w/*
    }
    handle @public_paths {
        import copyparty
    }
    handle {
        abort
    }
}

http://drive.{$SERVICE_DOMAIN} {
    @fpkgi {
        protocol http
        path /fpkgi/*
    }
    handle @fpkgi {
        import copyparty
    }
    handle {
        redir https://drive.{$SERVICE_DOMAIN}{uri} permanent
    }
}

slskd.{$SERVICE_DOMAIN} {
    import tls
    import rproxy slskd:5030
}

torrents.{$SERVICE_DOMAIN} {
    import tls
    handle /transmission/* {
        import rproxy transmission:9091
    }
    handle {
        import rproxy flood:3000
    }
}

aria.{$SERVICE_DOMAIN} {
    import tls
    @rpc {
        path /rpc
        path /jsonrpc
    }
    handle @rpc {
        import rproxy aria2:6800
    }
    handle {
        file_server {
            root /static/aria-ng
        }
    }
}

