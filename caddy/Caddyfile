(tls) {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }
}

vw.{$SERVICE_DOMAIN} {
    import tls
    reverse_proxy vw:80
}

drive.{$SERVICE_DOMAIN} {
    import tls
    reverse_proxy http://copyparty:3923
}

http://drive.{$SERVICE_DOMAIN} {
    @fpkgi {
        protocol http
        path /fpkgi/*
    }
    handle @fpkgi {
        reverse_proxy @fpkgi http://copyparty:3923
    }
    handle {
        redir https://drive.{$SERVICE_DOMAIN}{uri} permanent
    }
}

slskd.{$SERVICE_DOMAIN} {
    import tls
    reverse_proxy slskd:5030
}

torrents.{$SERVICE_DOMAIN} {
    import tls
    reverse_proxy transmission:9091 {
        header_up X-Real-IP {remote_host}
    }
}

picard.{$SERVICE_DOMAIN} {
    import tls
    reverse_proxy picard:5800
}

music.{$SERVICE_DOMAIN} {
    import tls
    reverse_proxy navidrome:4533
}
# separate domain for octo-fiesta
# acts as a simple switch to easily toggle between
# clean navidrome and octo-fiesta-powered navidrome API
music2.{$SERVICE_DOMAIN} {
    import tls
    handle /rest/* {
        reverse_proxy navidrome-octo-fiesta:8080
    }
    # octo-fiesta should not intercept any other apis
    handle {
        reverse_proxy navidrome:4533
    }
}

photos.{$SERVICE_DOMAIN} {
    import tls
    reverse_proxy http://immich-server:2283
}

links.{$SERVICE_DOMAIN} {
    import tls
    reverse_proxy http://linkwarden-server:3000
}

pihole.{$SERVICE_DOMAIN} {
    import tls
    reverse_proxy http://pihole:80
}

